    "vue": "3.5.45"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
